{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/areas/warragul",
      "destination": "/areas/gippsland",
      "permanent": true
    },
    {
      "source": "/vic",
      "destination": "/states/vic",
      "permanent": true
    },
    {
      "source": "/nsw",
      "destination": "/states/nsw",
      "permanent": true
    },
    {
      "source": "/qld",
      "destination": "/states/qld",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        }
      ]
    }
  ]
}
